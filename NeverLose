-- language: Luau, file: NLib.lua — keybindBox com suporte a MB1/MB2/MB3
local function keybindBox(win, parent, size, pos, anchor, default, onChange)
	local btn = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = T.Field,
		Size = size,
		AnchorPoint = anchor,
		Position = pos,
		ZIndex = 3,
		Parent = parent,
	}, { corner(5) })
	local st = new("UIStroke", { Color = T.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = btn })
	pressFx(btn, 0.94)
	local txt = label(btn, "keybind", 12, FONT, T.Dim, {
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 4,
	})
	win:_reg(btn)

	local obj = { Button = btn, Value = default, Waiting = false }
	local token = 0
	local armedAt = 0 -- ignora o input do mesmo frame em que Begin() foi chamado

	local function show()
		local n = shortKey(obj.Value)
		txt.Text = n or "keybind"
		txt.TextColor3 = n and T.Sub or T.Dim
	end

	function obj:Begin()
		if self.Waiting then
			return
		end
		self.Waiting = true
		token += 1
		armedAt = tick()
		local my = token
		tween(st, 0.2, { Color = T.Accent })
		txt.TextColor3 = T.Accent
		task.spawn(function()
			local n = 1
			while obj.Waiting and token == my do
				txt.Text = string.rep(".", n)
				n = n % 3 + 1
				task.wait(0.7)
			end
		end)
	end
	function obj:Get()
		return self.Value
	end
	function obj:Set(k, silent)
		self.Value = k
		show()
		if not silent then
			fire(onChange, k)
		end
	end

		btn.MouseButton1Click:Connect(function()
		obj:Begin()
	end)
	-- consome o clique direito para não abrir menu de contexto do jogador
	-- enquanto o usuário está capturando um bind
	btn.MouseButton2Click:Connect(function() end)
	btn.MouseEnter:Connect(function()
		if not obj.Waiting then
			tween(btn, 0.15, { BackgroundColor3 = T.FieldHover })
		end
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, 0.15, { BackgroundColor3 = T.Field })
	end)

	win:_connect(UIS.InputBegan, function(input)
		if not obj.Waiting then
			return
		end
		-- o clique que abriu a captura não pode ser capturado como bind
		if tick() - armedAt < 0.08 then
			return
		end

		local kb = input.UserInputType == Enum.UserInputType.Keyboard
		local mb = input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.MouseButton3
		if not (kb or mb) then
			return
		end

		obj.Waiting = false
		token += 1

		if kb then
			if input.KeyCode == Enum.KeyCode.Escape then
				obj.Value = nil
			elseif input.KeyCode ~= Enum.KeyCode.Unknown then
				obj.Value = input.KeyCode
			end
		else
			-- MouseButton1/2/3 são UserInputType e KeyCode ao mesmo tempo;
			-- guardamos o UserInputType para identificar a origem no compare.
			obj.Value = input.UserInputType
		end

		tween(st, 0.2, { Color = T.Stroke })
		show()
		fire(onChange, obj.Value)
	end)
	show()
	return obj
end

