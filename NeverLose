-- language: Luau, file: NLib.lua — shortKey com MB1/MB2/MB3
local function shortKey(k)
    if not k then
        return nil
    end
    if typeof(k) == "EnumItem" then
        if k.EnumType == Enum.UserInputType then
            if k == Enum.UserInputType.MouseButton1 then return "MB1" end
            if k == Enum.UserInputType.MouseButton2 then return "MB2" end
            if k == Enum.UserInputType.MouseButton3 then return "MB3" end
            if k == Enum.UserInputType.MouseMovement then return "MMove" end
            if k == Enum.UserInputType.MouseWheel then return "MWheel" end
            return k.Name
        end
        if k.EnumType == Enum.KeyCode then
            local n = k.Name:gsub("^Left", "L")
            n = n:gsub("^Right", "R")
            n = n:gsub("Control", "Ctrl")
            return n
        end
    end
    return tostring(k)
end

-- compara um bind (KeyCode OU UserInputType) com um InputObject
local function bindMatches(key, input)
    if not key or not input then
        return false
    end
    if typeof(key) == "EnumItem" and key.EnumType == Enum.UserInputType then
        return input.UserInputType == key
    end
    return input.KeyCode == key
end

